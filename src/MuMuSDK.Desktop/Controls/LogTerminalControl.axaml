<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MuMuSDK.Desktop.ViewModels"
             x:Class="MuMuSDK.Desktop.Controls.LogTerminalControl"
             x:DataType="vm:MainViewModel">

    <Grid ColumnDefinitions="*, 200">
        
        <!-- Left Side: Dedicated Text Logging Output Stream -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
                <TextBlock Text="DIAGNOSTIC TERMINAL LOG OUTPUT" Foreground="#A1A1AA" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding SelectedLogLevel}" Width="100" Height="24" FontSize="11" Background="#1A1A1F" BorderBrush="#3A3A45"/>
            </StackPanel>
            
            <ListBox Grid.Row="1" ItemsSource="{Binding TerminalLogLines}" Background="#0D0D11" BorderBrush="#3A3A45" BorderThickness="1" Padding="4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Courier New" FontSize="11" Foreground="#4AF626"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Right Side: Independent Source-Muting Filter Matrix -->
        <Border Grid.Column="1" BorderBrush="#3A3A45" BorderThickness="1,0,0,0" Margin="12,0,0,0" Padding="12,0,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="MODULE LOG MUTING" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold"/>
                <CheckBox IsChecked="{Binding MuteMmuEmulator}" Content="Mute MmuEmulator" FontSize="11" Foreground="White"/>
                <CheckBox IsChecked="{Binding MuteTaskEnumerator}" Content="Mute TaskEnumerator" FontSize="11" Foreground="White"/>
                <CheckBox IsChecked="{Binding MuteMemoryMapper}" Content="Mute MemoryMapper" FontSize="11" Foreground="White"/>
            </StackPanel>
        </Border>
        
    </Grid>
</UserControl>
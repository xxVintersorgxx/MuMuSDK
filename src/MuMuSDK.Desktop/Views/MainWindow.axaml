<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        
        xmlns:vm="using:MuMuSDK.Desktop.ViewModels"
        xmlns:c="using:MuMuSDK.Desktop.Controls"        
        x:Class="MuMuSDK.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        Icon="/Assets/avalonia-logo.ico"
        Title="MuMuSDK v10.0 - Virtual Machine Introspection Engine"
        Background="#1E1E24">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Main Window Layout Grid Tree -->
    <Grid RowDefinitions="Auto, *">
        
        <!-- Top Ribbon Layer Row 0 -->
        <Border Grid.Row="0" 
                Background="#25252D" 
                BorderBrush="#3A3A45" 
                BorderThickness="0,0,0,1" 
                Padding="8">
            <c:StagingRibbonControl DataContext="{Binding}" />
        </Border>

        <!-- Lower Application Workspace Area Row 1 -->
        <Grid Grid.Row="1" ColumnDefinitions="280, *" RowDefinitions="*, 200">
            
            <!-- Left Sidebar Panel: Verification Checkpoints (Col 0, Row 0 Span 1) -->
            <Border Grid.Column="0" Grid.Row="0" 
                    Background="#1E1E24" 
                    BorderBrush="#3A3A45" 
                    BorderThickness="0,0,1,0" 
                    Padding="12">
                <c:VerificationDashboardControl DataContext="{Binding}" />
            </Border>

            <!-- Center Panel: Real-time Telemetry Monitor Grid (Col 1, Row 0) -->
            <Border Grid.Column="1" Grid.Row="0" 
                    Background="#15151A" 
                    Padding="12">
                <c:TelemetryMonitorControl DataContext="{Binding}" />
            </Border>

            <!-- Bottom Panel: Low-Overhead Log Stream Console (Col 0-1 Span, Row 1) -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" 
                    Background="#1A1A1F" 
                    BorderBrush="#3A3A45" 
                    BorderThickness="0,1,0,0" 
                    Padding="12">
                <c:LogTerminalControl DataContext="{Binding}" />
            </Border>
            
        </Grid>
    </Grid>
</Window>
